{
  "manifest_version": "0.1.0",
  "program": {
    "image": "rimodock/purple-coding-agent:latest",
    "entrypoint": "uvicorn src.server:app --host 0.0.0.0 --port 9010",
    "mounts": [
      {
        "type": "bind",
        "source": "/var/run/docker.sock",
        "target": "/var/run/docker.sock",
        "description": "Required for Docker-out-of-Docker execution-based verification."
      }
    ],
    "network": {
      "endpoints": [
        {
          "name": "a2a",
          "port": 9010
        }
      ]
    },
    "env": {
      "LLM_BASE_URL": "https://openrouter.ai/api/v1",
      "MODEL_NAME": "deepseek/deepseek-v4-flash",
      "OPENROUTER_API_KEY": "${config.openrouter_key}",
      "GITHUB_TOKEN": "${config.github_token}",
      "MAX_TURNS": "50"
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {
      "openrouter_key": {
        "type": "string",
        "title": "OpenRouter API Key",
        "secret": true
      },
      "github_token": {
        "type": "string",
        "title": "GitHub Token",
        "secret": true
      }
    }
  },
  "provides": {
    "a2a": {
      "kind": "a2a",
      "endpoint": "a2a"
    }
  },
  "exports": {
    "a2a": "a2a"
  }
}