{
  "manifest_version": "0.3.0",
  "experimental_features": ["docker"],

  "config_schema": {
    "type": "object",
    "properties": {
      "openrouter_key": {
        "type": "string",
        "title": "OpenRouter API Key",
        "secret": true
      },
      "github_token": {
        "type": "string",
        "title": "GitHub Token",
        "secret": true
      }
    },
    "required": ["openrouter_key"]
  },

  "program": {
    "image": "rimodock/purple-coding-agent:latest",
    "entrypoint": "uvicorn src.server:app --host 0.0.0.0 --port 9022",

    "mounts": [
      { 
        "path": "/var/run/docker.sock", 
        "from": "framework.docker" 
      }
    ],

    "env": {
      "OPENROUTER_API_KEY": "${config.openrouter_key}",
      "GITHUB_TOKEN": "${config.github_token}",
      "LLM_BASE_URL": "https://openrouter.ai/api/v1",
      "MODEL_NAME": "minimax/minimax-m2.7",
      "MAX_TURNS": "30",
      "TASK_TIMEOUT_S": "280",
      "MAX_OBS_CHARS": "2500"
    },

    "network": {
      "endpoints": [
        { 
          "name": "a2a_endpoint", 
          "port": 9022
        }
      ]
    }
  },

  "provides": {
    "a2a": { 
      "kind": "a2a", 
      "endpoint": "a2a_endpoint" 
    }
  },

  "exports": {
    "a2a": "a2a"
  }
}